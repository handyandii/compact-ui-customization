<?xml version="1.0" encoding="utf-8"?>
<!--
    Home menu: big shortcut tiles to library categories, easy to use with a game controller.
    Shown over the tab pager in fragment_viewpager.xml, managed by HomeMenu.kt. The two rows sit
    side by side (4 x 1) on wide screens and stacked (2 x 2) on tall ones.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:visibility="gone"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/home_menu_grid"
        android:layout_width="match_parent"
        android:clipChildren="false"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/home_menu_row_1"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/home_menu_artists"
                layout="@layout/home_menu_tile" />

            <include
                android:id="@+id/home_menu_albums"
                layout="@layout/home_menu_tile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_menu_row_2"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/home_menu_songs"
                layout="@layout/home_menu_tile" />

            <include
                android:id="@+id/home_menu_playlists"
                layout="@layout/home_menu_tile" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
